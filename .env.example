# Copy this file to .env and fill in your key. `npm start` makes the copy for
# you the first time. .env is never committed.

# Optional. Leave it empty and receipts wait to be read by the Claude extension
# in Chrome. With a key from console.anthropic.com, each one is read at upload.
ANTHROPIC_API_KEY=

# The model that reads receipts when there is a key. No code to touch.
RECEIPT_MODEL=claude-haiku-5-5

# Where the database and the uploaded files live. Relative to backend/.
# DATA_DIR=./data

# Swagger API docs at /docs. Off unless you need them.
ENABLE_API_DOCS=false
